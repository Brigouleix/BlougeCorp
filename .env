# Base de données MySQL (XAMPP)
DB_HOST=127.0.0.1
DB_NAME=blougecorp
DB_USER=root
DB_PASS=

# SMTP — utilise Brevo (gratuit, 300 mails/jour) OU Gmail + App Password
# Brevo : MAIL_HOST=smtp-relay.brevo.com  PORT=587  USERNAME=ton-email  PASSWORD=ta-clé-SMTP-Brevo
# Gmail : MAIL_HOST=smtp.gmail.com  PORT=587  USERNAME=ton@gmail.com  PASSWORD=mot-de-passe-application (pas ton vrai mdp)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@blouge.fr
MAIL_FROM_NAME=BlougeCorp

# URL du frontend (utilisée dans les liens email)
APP_URL=http://localhost:3000

# JWT
JWT_SECRET=blougecorp-secret-change-me-in-production
