{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend-web", "start"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "php",
      "runtimeArgs": ["-S", "127.0.0.1:8000", "-t", "backend/public", "backend/public/index.php"],
      "port": 8000
    }
  ]
}
